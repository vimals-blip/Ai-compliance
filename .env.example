# ==============================================
# AI-Compliance Platform Environment Configuration
# ==============================================

# Node / NestJS Business API
NODE_ENV=development
PORT=4000
API_PREFIX=/api
JWT_SECRET=supersecret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://compliance_user:compliance_password@localhost:5432/compliance_db?schema=public

# Background Queue (Redis / BullMQ)
REDIS_URL=redis://localhost:6379

# Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=compliance-evidence
S3_USE_SSL=false

# AI Service (Python / FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=dev-internal-ai-key-change-in-prod

# LLM & Embedding Settings
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Web App (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="AI-Compliance"
